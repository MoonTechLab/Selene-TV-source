<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView 背景的 PlayerView。
  默认 PlayerView 用 SurfaceView：视频像素在独立的合成层上，不受 Compose alpha/transform 动画影响——
  退出播放页 fadeOut/slideOut 时，画面外的黑边先淡出露出下层页面、中间视频再「啪」地消失。
  改用 texture_view 后视频随普通视图层一起淡出/位移，退场动画才完整。详见 PlayerScreen.kt 注释。
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
