<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 开发环境：信任所有证书（包括自签名和过期证书） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- 调试配置：信任所有证书 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
